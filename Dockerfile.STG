# ==========================================
# Stage 1 - Build React/PROD_VITE Application
# ==========================================
FROM node:24-alpine AS build

WORKDIR /app

COPY package*.json ./

RUN npm ci

COPY . .

# Microsoft Entra ID sign-in (MSAL), baked into the JS bundle at build time - IDs only, never secrets.
# Pass with --build-arg (or compose build.args from .env). Without VITE_MSAL_CLIENT_ID the
# "Sign in with Microsoft" button is hidden. See .env.example for each value.
ARG VITE_API_BASE_URL_STG
ENV VITE_API_BASE_URL_STG=${VITE_API_BASE_URL_STG}

ARG VITE_MSAL_CLIENT_ID_STG
ENV VITE_MSAL_CLIENT_ID_STG=${VITE_MSAL_CLIENT_ID_STG}

ARG VITE_MSAL_TENANT_ID_STG
ENV VITE_MSAL_TENANT_ID_STG=${VITE_MSAL_TENANT_ID_STG}

ARG VITE_MSAL_AUTHORITY_STG
ENV VITE_MSAL_AUTHORITY_STG=${VITE_MSAL_AUTHORITY_STG}

ARG VITE_MSAL_REDIRECT_URI_STG
ENV VITE_MSAL_REDIRECT_URI_STG=${VITE_MSAL_REDIRECT_URI_STG}

ARG VITE_MSAL_POST_LOGOUT_REDIRECT_URI_STG
ENV VITE_MSAL_POST_LOGOUT_REDIRECT_URI_STG=${VITE_MSAL_POST_LOGOUT_REDIRECT_URI_STG}

ARG VITE_MSAL_API_SCOPE_STG
ENV VITE_MSAL_API_SCOPE_STG=${VITE_MSAL_API_SCOPE_STG}


RUN npm run build

# ==========================================
# Stage 2 - Nginx Runtime (non-root, port 8080)
# ==========================================
# Alpine's own nginx package replaces nginxinc/nginx-unprivileged:stable-alpine (nginx 1.30.6, no patched
# image published yet). Security fixes enforced at build time - the build fails if a fixed version is missing:
#   nginx       >= 1.30.7-r0  CVE-2026-113425, CVE-2026-121810, CVE-2026-123007, CVE-2026-123633, CVE-2026-123634
#   zlib        >= 1.4-r0     CVE-2026-4738
#   brotli-libs >= 1.2.1-r0   CVE-2026-111497 (only if present; the nginx package does not need it)
#   curl / libcurl            CVE-2026-86411, -86413, -86414, -87861, -87866, -92388, -94265: not installed at all
#                             (the health check uses busybox wget)
FROM alpine:3.24@sha256:f59abe656b692d901e184be3445e084786602108599d2a51d229c0f5a48c71bf AS runtime

# Fixed uid/gid 101 (same as nginxinc/nginx-unprivileged), created before the nginx package so it is reused:
# Kubernetes runAsNonRoot / runAsUser: 101 work with a numeric USER.
RUN set -eux; \
    addgroup -S -g 101 nginx; \
    adduser -S -D -H -u 101 -G nginx -h /var/lib/nginx -s /sbin/nologin -g nginx nginx; \
    apk upgrade --no-cache; \
    apk add --no-cache 'nginx>=1.30.7-r0' 'zlib>=1.4-r0'; \
    test "$(id -u nginx)" = 101; \
    if apk info -e brotli-libs >/dev/null 2>&1; then apk add --no-cache 'brotli-libs>=1.2.1-r0'; fi; \
    for p in curl libcurl; do if apk info -e "$p" >/dev/null 2>&1; then apk del --no-cache "$p"; fi; done; \
    for p in curl libcurl; do if apk info -e "$p" >/dev/null 2>&1; then echo "$p must not be installed" >&2; exit 1; fi; done; \
    mkdir -p /usr/share/nginx/html /var/lib/nginx /var/log/nginx /run/nginx; \
    chown -R nginx:nginx /usr/share/nginx/html /var/lib/nginx /var/log/nginx /run/nginx; \
    nginx -v

COPY nginx.conf /etc/nginx/nginx.conf
COPY --from=build --chown=nginx:nginx /app/dist /usr/share/nginx/html

USER nginx
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -q -O /dev/null http://127.0.0.1:8080/healthz || exit 1

# Static files only: /api/ is routed to the backend in front of this container (ingress), see nginx.conf
CMD ["nginx", "-g", "daemon off;"]
