# Microsoft Entra ID (Azure AD) sign-in - read by Vite at build time (npm run dev / build, Docker build args).
# Values are IDs, not secrets: they end up in the browser bundle. Never put a client secret here.
# Without VITE_MSAL_CLIENT_ID the "Sign in with Microsoft" button is hidden (password sign-in only).

# Application (client) ID of the SPA app registration (platform: Single-page application)
VITE_MSAL_CLIENT_ID=
# Directory (tenant) ID
VITE_MSAL_TENANT_ID=
# Optional; default https://login.microsoftonline.com/<VITE_MSAL_TENANT_ID>
VITE_MSAL_AUTHORITY=
# Optional; default <app origin>/login - register it as a SPA redirect URI (e.g. http://localhost:5173/login)
VITE_MSAL_REDIRECT_URI=
# Optional; default <app origin>/login
VITE_MSAL_POST_LOGOUT_REDIRECT_URI=
# Scope of the API app registration; the backend validates this access token (AZURE_AD_* in backend/.env).
# Empty = the ID token is sent instead (then set the backend AZURE_AD_AUDIENCE to the SPA client id and AZURE_AD_REQUIRED_SCOPE empty)
VITE_MSAL_API_SCOPE=api://<API client id>/access_as_user

# Dev server only: where /api is proxied (vite.config.js)
VITE_API_PROXY_TARGET=http://localhost:4000
