# ENVIRONMENT selects which variables below are used (src/config/env.js); allowed: DEV, STAGE, PROD.
#   DEV   -> VITE_<NAME>_DEV    (pipeline: Dockerfile.DEV sets ENVIRONMENT=DEV,   secrets VITE_*_DEV)
#   STAGE -> VITE_<NAME>_STG    (pipeline: Dockerfile.STG sets ENVIRONMENT=STAGE, secrets VITE_*_STG)
#   PROD  -> VITE_<NAME>        (pipeline: Dockerfile sets ENVIRONMENT=PROD,      secrets VITE_*); also when empty
# No fallback between sets: with ENVIRONMENT=DEV only the _DEV names are read. Values are IDs/URLs, never secrets.
ENVIRONMENT=DEV

# ---------- DEV (ENVIRONMENT=DEV) ----------
# API origin (or full root ending in /api). Empty = same origin /api (ingress / local proxy / vite dev proxy).
# Cross-origin: the backend CORS_ORIGINS must list this app's origin.
VITE_API_BASE_URL_DEV=
# Entra ID: SPA app registration client id + tenant id. Without the client id the Microsoft button is hidden.
VITE_MSAL_CLIENT_ID_DEV=
VITE_MSAL_TENANT_ID_DEV=
# Optional; default https://login.microsoftonline.com/<tenant id>
VITE_MSAL_AUTHORITY_DEV=
# Optional; default <app origin>/login - register it as a SPA redirect URI
VITE_MSAL_REDIRECT_URI_DEV=
VITE_MSAL_POST_LOGOUT_REDIRECT_URI_DEV=
# Scope of the API app registration (backend AZURE_AD_*); empty = ID token is sent instead
VITE_MSAL_API_SCOPE_DEV=api://<API client id>/access_as_user

# ---------- STAGE (ENVIRONMENT=STAGE) ----------
# API origin (or full root ending in /api). Empty = same origin /api (ingress / local proxy / vite dev proxy).
# Cross-origin: the backend CORS_ORIGINS must list this app's origin.
VITE_API_BASE_URL_STG=
# Entra ID: SPA app registration client id + tenant id. Without the client id the Microsoft button is hidden.
VITE_MSAL_CLIENT_ID_STG=
VITE_MSAL_TENANT_ID_STG=
# Optional; default https://login.microsoftonline.com/<tenant id>
VITE_MSAL_AUTHORITY_STG=
# Optional; default <app origin>/login - register it as a SPA redirect URI
VITE_MSAL_REDIRECT_URI_STG=
VITE_MSAL_POST_LOGOUT_REDIRECT_URI_STG=
# Scope of the API app registration (backend AZURE_AD_*); empty = ID token is sent instead
VITE_MSAL_API_SCOPE_STG=api://<API client id>/access_as_user

# ---------- PROD (ENVIRONMENT=PROD) ----------
# API origin (or full root ending in /api). Empty = same origin /api (ingress / local proxy / vite dev proxy).
# Cross-origin: the backend CORS_ORIGINS must list this app's origin.
VITE_API_BASE_URL=
# Entra ID: SPA app registration client id + tenant id. Without the client id the Microsoft button is hidden.
VITE_MSAL_CLIENT_ID=
VITE_MSAL_TENANT_ID=
# Optional; default https://login.microsoftonline.com/<tenant id>
VITE_MSAL_AUTHORITY=
# Optional; default <app origin>/login - register it as a SPA redirect URI
VITE_MSAL_REDIRECT_URI=
VITE_MSAL_POST_LOGOUT_REDIRECT_URI=
# Scope of the API app registration (backend AZURE_AD_*); empty = ID token is sent instead
VITE_MSAL_API_SCOPE=api://<API client id>/access_as_user

# Dev server only (npm run dev): where /api is proxied (vite.config.js); not per environment
VITE_API_PROXY_TARGET=http://localhost:4000
